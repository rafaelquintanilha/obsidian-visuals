{
  "name": "obsidian-visuals",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "agent": "tsx agent.ts",
    "conversation": "pnpm run agent --",
    "check": "tsx agent.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sqlite3"
    ]
  }
}
